{
    "env": {
        "browser": true,
        "es6": true,
        "jquery": true
    },
    "extends": ["jquery", "eslint:recommended"],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly",
        "moment": true,
        "angular": true,
        "Thinx": true,
        "Morris":true,
        "Layout": true,
        "QuickSidebar": true,
        "Theme": true,
        "getTimezones": true,
        "CryptoJS": true,
        "toastr": true,
        "App": true
    },
    "parserOptions": {
        "ecmaVersion": 2018
    },
    "overrides": [
        {
            "files": ["cypress/**/*.js"],
            "env": {
                "browser": true,
                "node": true,
                "mocha": true
            },
            "globals": {
                "Cypress": "readonly",
                "cy": "readonly",
                "expect": "readonly",
                "assert": "readonly"
            },
            "parserOptions": {
                "ecmaVersion": 2020,
                "sourceType": "script"
            }
        },
        {
            "files": ["cypress/support/index.js"],
            "parserOptions": {
                "ecmaVersion": 2020,
                "sourceType": "module"
            }
        }
    ],
    "rules": {
        "no-console": "off",
        "no-unused-vars": "off",
        "lines-around-comment": "off",
        "max-len": "off",
        "camelcase": "off",
        "eqeqeq": "off",
        "dot-notation": "off",
        "no-useless-escape": "off",
        "quotes": ["warn", "double"]
    }
}
